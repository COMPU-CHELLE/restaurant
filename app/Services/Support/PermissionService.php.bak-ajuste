<?php

namespace App\Services\Support;

use App\Models\Support\Level;
use App\Models\Support\Module;
use App\Models\Support\Permission;
use App\Models\Tenant\ProfilePermission;

class PermissionService
{
    /**
     * Permisos de un perfil del tenant, resueltos contra el catálogo de la base support.
     *
     * @return array<int, array{name:string, codmod:int, codniv:int, codite:int}>
     */
    public function forProfile(int $profileId): array
    {
        $ids = ProfilePermission::query()->where('profile_id', $profileId)->pluck('permission_id');

        return Permission::query()
            ->whereIn('codmov', $ids)
            ->get(['codmov', 'name', 'codmod', 'codniv', 'codite'])
            ->map(fn ($p) => [
                'name'   => strtolower((string) $p->name),
                'codmod' => (int) $p->codmod,
                'codniv' => (int) $p->codniv,
                'codite' => (int) $p->codite,
            ])
            ->all();
    }

    /**
     * Ámbito de un módulo, según el primer segmento de su URL:
     *   /soporte/…  → SOPORTE   (gestión global de la plataforma)
     *   /admin/…    → ADMIN     (administración de la empresa)
     *   cualquier otro → OPERATIVO (lo que se asigna por perfil)
     */
    public function scopeOf(Module $module): string
    {
        $first = strtolower(explode('/', trim((string) $module->url, '/'))[0] ?? '');

        return match ($first) {
            'soporte' => 'SOPORTE',
            'admin' => 'ADMIN',
            default => 'OPERATIVO',
        };
    }

    /**
     * Menú Módulo → Nivel según el rol:
     *   SOPORTE → siempre la gestión global; dentro de una empresa, además lo de ADMIN y lo operativo.
     *   ADMIN   → administración de su empresa + todo lo operativo.
     *   USER    → solo lo operativo que su perfil permita ("view" en el nivel).
     *
     * @param  array<int, array{name:string, codniv:int}>|null  $permissions  solo para USER
     * @return array<int, array{title:string, icon:?string, items:array<int, array{title:string, href:string, icon:?string}>}>
     */
    public function menu(string $roleCode, ?array $permissions, bool $inCompany): array
    {
        $scopes = match (strtoupper($roleCode)) {
            'SOPORTE' => $inCompany ? ['SOPORTE', 'ADMIN', 'OPERATIVO'] : ['SOPORTE'],
            'ADMIN' => ['ADMIN', 'OPERATIVO'],
            default => ['OPERATIVO'],
        };

        $allowed = null;
        if ($permissions !== null) {
            $allowed = collect($permissions)
                ->filter(fn ($p) => str_ends_with($p['name'], '.view') && $p['codniv'] > 0)
                ->pluck('codniv')
                ->flip();
        }

        $levels = Level::query()
            ->where('state', 1)
            ->where('type', 'LEVEL')
            ->orderBy('code')
            ->get()
            ->groupBy('parent');

        $rank = ['SOPORTE' => 0, 'OPERATIVO' => 1, 'ADMIN' => 2];
        $menu = [];

        foreach (Module::query()->where('state', 1)->orderBy('code')->get() as $module) {
            $scope = $this->scopeOf($module);

            if (! in_array($scope, $scopes, true)) {
                continue;
            }

            $items = [];

            foreach ($levels->get($module->code, collect()) as $level) {
                if ($allowed !== null && ! $allowed->has((int) $level->codmov)) {
                    continue;
                }

                $items[] = ['title' => $level->name, 'href' => $level->url, 'icon' => $level->icon];
            }

            if ($items) {
                $menu[] = [
                    'title' => $module->name, 'icon' => $module->icon, 'items' => $items,
                    '_rank' => $rank[$scope], '_code' => $module->code,
                ];
            }
        }

        usort($menu, fn ($a, $b) => [$a['_rank'], $a['_code']] <=> [$b['_rank'], $b['_code']]);

        return array_map(function ($m) {
            unset($m['_rank'], $m['_code']);

            return $m;
        }, $menu);
    }
}
