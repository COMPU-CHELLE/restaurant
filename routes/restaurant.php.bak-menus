<?php

use Illuminate\Support\Facades\Route;

/*
|--------------------------------------------------------------------------
| Páginas provisionales de los módulos
|--------------------------------------------------------------------------
| Cada URL coincide con un nivel del árbol de permisos (SupportSecuritySeeder),
| así que el middleware "permission" deriva el permiso (…view) de la propia ruta.
| Las siguientes fases reemplazan cada una por su controlador real.
*/
Route::middleware(['auth', 'verified', 'restaurant'])->group(function () {
    $pages = [
        '/operacion/mesas' => 'Mesas',
        '/operacion/ordenes' => 'Órdenes',
        '/operacion/caja' => 'Caja',
        '/catalogo/productos' => 'Productos',
        '/catalogo/categorias' => 'Categorías',
        '/inventario/movimientos' => 'Movimientos de inventario',
        '/terceros/contactos' => 'Clientes y proveedores',
        '/configuracion/empresa' => 'Datos del restaurante',
        '/configuracion/areas' => 'Salones y áreas',
        '/configuracion/cajas' => 'Cajas registradoras',
        '/configuracion/metodos-pago' => 'Métodos de pago',
        '/configuracion/impresoras' => 'Impresoras',
        '/seguridad/usuarios' => 'Usuarios',
        '/seguridad/perfiles' => 'Perfiles',
        '/reportes/ventas' => 'Ventas',
    ];

    foreach ($pages as $url => $title) {
        Route::inertia($url, 'module-placeholder', ['title' => $title])
            ->middleware('permission')
            ->name(str_replace('/', '.', trim($url, '/')));
    }
});
